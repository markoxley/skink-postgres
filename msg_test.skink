// File:    msg_test.skink
// Purpose: Unit tests for pg_msg — the big-endian wire codec, OutBuf
//          binary-safe buffer, and Cursor field decoding. Guards the
//          exact byte layout of typed messages.
module msg_test

import "pg_msg"
import "std/str"
import "std/libc"
import "std/testing"

// Raw byte accessors for binary wire/test buffers — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte.
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)


// TestOutBufScalars verifies big-endian int16/int32 encoding.
pub fn TestOutBufScalars() {
    b := pg_msg.NewOutBuf(8)
    pg_msg.I16(&b, 0x1234)
    pg_msg.I32(&b, 0x01020304)
    pg_msg.Byte(&b, 65)
    data, n := pg_msg.Data(&b)
    testing.AssertEqualInt(7, n, "buffer length")
    testing.AssertEqualInt(0x12, Skink_mem_byte(data, int64(0)), "i16 hi")
    testing.AssertEqualInt(0x34, Skink_mem_byte(data, int64(1)), "i16 lo")
    testing.AssertEqualInt(1, Skink_mem_byte(data, int64(2)), "i32 b0")
    testing.AssertEqualInt(2, Skink_mem_byte(data, int64(3)), "i32 b1")
    testing.AssertEqualInt(3, Skink_mem_byte(data, int64(4)), "i32 b2")
    testing.AssertEqualInt(4, Skink_mem_byte(data, int64(5)), "i32 b3")
    testing.AssertEqualInt(65, Skink_mem_byte(data, int64(6)), "byte")
    pg_msg.Free(&b)
}

// TestOutBufBinarySafe verifies WriteN preserves interior NUL bytes —
// strlen-based builders truncate them. (Skink literals have no \x
// escapes; build raw bytes via malloc.)
pub fn TestOutBufBinarySafe() {
    b := pg_msg.NewOutBuf(8)
    raw := libc.malloc(6)
    Skink_mem_write_byte(raw, int64(0), 0)
    Skink_mem_write_byte(raw, int64(1), 1)
    Skink_mem_write_byte(raw, int64(2), 0)
    Skink_mem_write_byte(raw, int64(3), 2)
    Skink_mem_write_byte(raw, int64(4), 0)
    Skink_mem_write_byte(raw, int64(5), 0)
    pg_msg.WriteN(&b, raw, 5)
    pg_msg.I32(&b, -1) // NULL param marker must encode as 0xFFFFFFFF
    data, n := pg_msg.Data(&b)
    testing.AssertEqualInt(9, n, "binary len")
    testing.AssertEqualInt(0, Skink_mem_byte(data, int64(0)), "nul byte 0")
    testing.AssertEqualInt(1, Skink_mem_byte(data, int64(1)), "byte 1")
    testing.AssertEqualInt(0, Skink_mem_byte(data, int64(2)), "nul byte 2")
    testing.AssertEqualInt(255, Skink_mem_byte(data, int64(5)), "-1 b0")
    testing.AssertEqualInt(255, Skink_mem_byte(data, int64(8)), "-1 b3")
    pg_msg.Free(&b)
}

// TestCursorRoundtrip encodes then decodes a structured body.
pub fn TestCursorRoundtrip() {
    b := pg_msg.NewOutBuf(32)
    pg_msg.CStr(&b, "server_version")
    pg_msg.CStr(&b, "15.0")
    pg_msg.I32(&b, 5432)
    pg_msg.I16(&b, 300)
    pg_msg.Byte(&b, 74)
    body, n := pg_msg.Data(&b)

    c := pg_msg.NewCursor(body, n)
    testing.AssertEqualString("server_version", pg_msg.CCStr(&c), "first cstr")
    testing.AssertEqualString("15.0", pg_msg.CCStr(&c), "second cstr")
    testing.AssertEqualInt(5432, pg_msg.CI32(&c), "i32")
    testing.AssertEqualInt(300, pg_msg.CI16(&c), "i16")
    testing.AssertEqualInt(74, pg_msg.CByte(&c), "byte")
    testing.AssertEqualInt(0, pg_msg.Remaining(&c), "exhausted")
    testing.AssertEqualInt(-1, pg_msg.CByte(&c), "read past end")
    pg_msg.Free(&b)
}

// TestCursorCBytes verifies explicit-length byte reads.
pub fn TestCursorCBytes() {
    b := pg_msg.NewOutBuf(16)
    abcd := libc.malloc(6)
    Skink_mem_write_byte(abcd, 0, 97)
    Skink_mem_write_byte(abcd, 1, 98)
    Skink_mem_write_byte(abcd, 2, 0)
    Skink_mem_write_byte(abcd, 3, 99)
    Skink_mem_write_byte(abcd, 4, 100)
    Skink_mem_write_byte(abcd, 5, 0)
    pg_msg.WriteN(&b, abcd, 5)
    pg_msg.I16(&b, 7)
    body, n := pg_msg.Data(&b)

    c := pg_msg.NewCursor(body, n)
    s, got := pg_msg.CBytes(&c, 5)
    testing.AssertEqualInt(5, got, "cbytes len")
    testing.AssertEqualInt(97, Skink_mem_byte(s, int64(0)), "a")
    testing.AssertEqualInt(0, Skink_mem_byte(s, int64(2)), "embedded NUL")
    testing.AssertEqualInt(100, Skink_mem_byte(s, int64(4)), "d")
    testing.AssertEqualInt(7, pg_msg.CI16(&c), "tail i16")
    pg_msg.Free(&b)
}
